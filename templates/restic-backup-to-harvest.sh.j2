#!/bin/bash
set -euo pipefail

# Managed by Ansible — do not edit by hand.
# Source: {{ ansible_managed }}

# ============================================================================
# restic backup: {{ inventory_hostname }} → harvest
# Runs from DSM Task Scheduler as root.
# Lives inside an encrypted DSM shared folder when so configured — backup
# will not run after a reboot until the folder is manually unlocked. Missed
# runs are caught by healthcheck.io's missing-run alert.
# ============================================================================

# --- healthcheck.io ---
HC_UUID="{{ cr_synology_backup_healthcheck_uuid }}"
HC_BASE="{{ cr_synology_backup_healthcheck_base_url }}/${HC_UUID}"

# --- restic ---
export RESTIC_REPOSITORY="{{ cr_synology_backup_repo_url }}"
export RESTIC_PASSWORD_FILE="{{ cr_synology_backup_repo_password_file }}"

SFTP_CMD="ssh -i {{ cr_synology_backup_ssh_key_path }} -o StrictHostKeyChecking=accept-new {{ cr_synology_backup_ssh_user }}@{{ cr_synology_backup_ssh_target_host }} -s sftp"

# --- logging ---
LOG_DIR="{{ cr_synology_backup_log_dir }}"
LOG="${LOG_DIR}/restic-backup-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"

# --- hooks ---
ping_failure() {
    curl -fsS -m 10 --retry 3 --data-binary @"$LOG" "${HC_BASE}/fail" >/dev/null 2>&1 || true
}
trap ping_failure ERR

curl -fsS -m 10 --retry 3 "${HC_BASE}/start" >/dev/null 2>&1 || true

# --- backup ---
{
    echo "=== restic backup started $(date -Iseconds) ==="
    echo "host: $(hostname), repo: ${RESTIC_REPOSITORY}"

    restic -o sftp.command="$SFTP_CMD" backup \
{%- for path in cr_synology_backup_paths %}
        {{ path | quote }}{% if not loop.last or (cr_synology_backup_excludes | default([]) | length > 0) %} \{% endif %}
{%- endfor %}
{%- for excl in cr_synology_backup_excludes | default([]) %}
        --exclude={{ excl | quote }}{% if not loop.last %} \{% endif %}
{%- endfor %}

    echo "=== restic forget + prune started $(date -Iseconds) ==="

    restic -o sftp.command="$SFTP_CMD" forget \
        --keep-daily {{ cr_synology_backup_retention.keep_daily }} \
        --keep-weekly {{ cr_synology_backup_retention.keep_weekly }} \
        --keep-monthly {{ cr_synology_backup_retention.keep_monthly }} \
        --keep-yearly {{ cr_synology_backup_retention.keep_yearly }} \
        --prune

    echo "=== restic backup completed $(date -Iseconds) ==="
} >> "$LOG" 2>&1

curl -fsS -m 10 --retry 3 --data-binary @"$LOG" "${HC_BASE}" >/dev/null 2>&1 || true

# --- local log retention (repo retention is handled by restic forget above) ---
find "$LOG_DIR" -name 'restic-backup-*.log' -mtime +{{ cr_synology_backup_log_retention_days }} -delete 2>/dev/null || true
