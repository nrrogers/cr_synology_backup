#!/bin/bash
set -euo pipefail

# Managed by Ansible — do not edit by hand.
# Source: {{ ansible_managed }}

# ============================================================================
# restic backup: {{ inventory_hostname }} → harvest
# Runs from DSM Task Scheduler as root.
# Lives inside an encrypted DSM shared folder when so configured — backup
# will not run after a reboot until the folder is manually unlocked. Missed
# runs are caught by healthcheck.io's missing-run alert.
# ============================================================================

# --- healthcheck.io ---
HC_URL="{{ cr_synology_backup_healthcheck_url }}"
LOCATION="{{ cr_synology_backup_location_name }}"

# --- restic ---
export RESTIC_REPOSITORY="{{ cr_synology_backup_repo_url }}"
export RESTIC_PASSWORD_FILE="{{ cr_synology_backup_repo_password_file }}"
# Cache and tmp must live on /volume1 — DSM's rootfs is too small for a
# multi-TB source's index or staged packs (see role defaults).
export RESTIC_CACHE_DIR="{{ cr_synology_backup_cache_dir }}"
export TMPDIR="{{ cr_synology_backup_tmp_dir }}"

SFTP_CMD="ssh -i {{ cr_synology_backup_ssh_key_path }} -o StrictHostKeyChecking=accept-new {{ cr_synology_backup_ssh_user }}@{{ cr_synology_backup_ssh_target_host }} -s sftp"

# --- logging ---
LOG_DIR="{{ cr_synology_backup_log_dir }}"
LOG="${LOG_DIR}/restic-backup-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"

# --- hooks ---
# Failure: post a short status message to /fail. Mirrors the autorestic
# convention ("Backup failed for location: <name>"). Full backup output
# lives in the log file at $LOG for forensics.
ping_failure() {
    curl -fsS -m 10 --retry 5 -X POST -H "Content-Type: text/plain" \
        --data "Backup failed for location: ${LOCATION}" \
        "${HC_URL}/fail" >/dev/null 2>&1 || true
}
trap ping_failure ERR

# Start ping
curl -fsS -m 10 --retry 5 "${HC_URL}/start" >/dev/null 2>&1 || true

# --- backup ---
# restic exit codes: 0 = clean; 3 = completed but one or more source files
# could not be read (e.g. a live Time Machine band or the Home Assistant DB
# rotating mid-run). Exit 3 still writes a valid snapshot, so treat it as
# success and go on to forget/prune. Any other non-zero code is re-raised so
# `set -e` + the ERR trap still ping /fail on a genuine failure. The `|| ...`
# idiom is deliberate: it stops both errexit and the ERR trap from firing on
# the captured exit code so exit 3 does not raise a false failure alert.
{
    echo "=== restic backup started $(date -Iseconds) ==="
    echo "host: $(hostname), repo: ${RESTIC_REPOSITORY}, location: ${LOCATION}"

    backup_rc=0
    {{ cr_synology_backup_restic_binary }} -o sftp.command="$SFTP_CMD" backup \
{%- for path in cr_synology_backup_paths %}
        {{ path | quote }} \
{%- endfor %}
{%- for excl in cr_synology_backup_excludes | default([]) %}
        --exclude={{ excl | quote }} \
{%- endfor %}
        || backup_rc=$?

    if [ "$backup_rc" -eq 3 ]; then
        echo "WARNING: restic backup exit 3 — some source files could not be read; snapshot is still valid, continuing"
    elif [ "$backup_rc" -ne 0 ]; then
        echo "ERROR: restic backup failed with exit code ${backup_rc}"
        ( exit "$backup_rc" )
    fi

    echo "=== restic forget + prune started $(date -Iseconds) ==="

    {{ cr_synology_backup_restic_binary }} -o sftp.command="$SFTP_CMD" forget \
        --keep-last {{ cr_synology_backup_retention.keep_last }} \
        --keep-daily {{ cr_synology_backup_retention.keep_daily }} \
        --keep-weekly {{ cr_synology_backup_retention.keep_weekly }} \
        --keep-monthly {{ cr_synology_backup_retention.keep_monthly }} \
        --keep-yearly {{ cr_synology_backup_retention.keep_yearly }} \
        --prune

    echo "=== restic backup completed $(date -Iseconds) ==="
} >> "$LOG" 2>&1

# Success: post a short status message to the base URL. Mirrors autorestic
# convention. Full backup output stays in the local log file.
curl -fsS -m 10 --retry 5 -X POST -H "Content-Type: text/plain" \
    --data "Backup successful for location: ${LOCATION}" \
    "${HC_URL}" >/dev/null 2>&1 || true

# --- local log retention (repo retention is handled by restic forget above) ---
find "$LOG_DIR" -name 'restic-backup-*.log' -mtime +{{ cr_synology_backup_log_retention_days }} -delete 2>/dev/null || true
